{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exis.Architect",
  "version": "2.0.0",
  "identifier": "com.plane.exisarchitect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "exis.Architect",
        "width": 1000,
        "height": 680,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "exis.HUD",
        "width": 380,
        "height": 450,
        "decorations": false,    
        "transparent": true,    
        "alwaysOnTop": true,    
        "visible": false,        
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": [
        "binaries/**/*"
      ],
      "targets": ["nsis"],
      "windows": {
        "nsis": {
           "installerHooks": "nsis/installer.nsh"
        }
      }
    }
}
